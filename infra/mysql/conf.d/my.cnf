[mysqld]
# ---------------------------------------------------------------
# CDC(Debezium)를 위한 binlog 설정
# ---------------------------------------------------------------
server-id                  = 1
log_bin                    = mysql-bin
# 8.0.34부터 deprecated(기본값이 ROW)지만, CDC 전제 조건이라 의도를 드러내려고 명시
binlog_format              = ROW
# 변경 전/후 모든 컬럼을 기록해야 Debezium이 완전한 이벤트를 만들 수 있음
binlog_row_image           = FULL
# binlog 보존 3일. 커넥터가 오래 멈추면 읽을 위치의 binlog가 사라질 수 있음 (실험 소재)
binlog_expire_logs_seconds = 259200
# GTID: 커넥터 재시작·failover 시 위치를 파일 오프셋이 아닌 트랜잭션 ID로 추적
gtid_mode                  = ON
enforce_gtid_consistency   = ON

# ---------------------------------------------------------------
# 로컬 리소스 제한
# ---------------------------------------------------------------
innodb_buffer_pool_size    = 512M
max_connections            = 300

# ---------------------------------------------------------------
# 시간대: DATETIME에는 시간대 정보가 없어 Debezium이 UTC로 해석함
# 서버·앱 모두 UTC로 통일해 변환 혼란을 막음
# ---------------------------------------------------------------
default_time_zone          = '+00:00'
